---
const title = 'Astro Portfolio on Weond';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #0a0a0a;
        color: #f4f4f6;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif;
      }
      main {
        width: min(100%, 520px);
        padding: 28px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.04);
      }
      p.kicker {
        margin: 0 0 10px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }
      h1 {
        margin: 0 0 10px;
        font-size: 28px;
        letter-spacing: -0.03em;
      }
      p {
        margin: 0;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.66);
      }
    </style>
  </head>
  <body>
    <main>
      <p class="kicker">[ deployed on weond ]</p>
      <h1>{title}</h1>
      <p>Edit <code>src/pages/index.astro</code> and push to GitHub to publish updates automatically.</p>
    </main>
  </body>
</html>
